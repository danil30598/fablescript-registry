var age = 18
var hasTicket = true

if age >= 18 and hasTicket {
    print("Доступ разрешён")
} else {
    print("Доступ запрещён")
}

if age == 18 {
    print("Ровно восемнадцать")
}

var score = 75

if score > 100 {
    print("Победа")
} else if score > 50 {
    print("Почти победа")
} else {
    print("Продолжай")
}

var target = null
if target == null {
    print("Цель не выбрана")
}
