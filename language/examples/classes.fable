class Person
{
    var name
    var age

    __init(name, age)
    {
        self.name = name
        self.age = age
    }

    func greet()
    {
        print("Привет, " + self.name)
    }

    func getAge()
    {
        return self.age
    }
}

var person = Person("Alex", 18)
person.greet()
print(person.name)
print(person.getAge())
